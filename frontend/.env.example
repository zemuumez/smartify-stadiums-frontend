# Explicitly opt in for a demonstration. Unset defaults to API, never to demo.
NEXT_PUBLIC_DATA_MODE=demo
# Full versioned API base; prefer same-origin routing in production.
NEXT_PUBLIC_API_URL=/api/v1

# Optional: enables venue subdomains; bare hostname with optional local port, no scheme.
# Production example: NEXT_PUBLIC_ROOT_DOMAIN=yourdomain.com
# Local example: NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=
